{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "flux": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },

  // Scoped to values/HelmRelease files only - matching every *.yaml like the
  // kubernetes manager double-extracts image: lines and inflates minimumGroupSize counts
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml$/",
      "/(^|/)helm-release\\.ya?ml$/"
    ]
  },

  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml$/"]
  }
}
