{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>William-Ro/renovate-config//default.json5"],

  "flux": { "managerFilePatterns": ["/\\.yaml$/"] },
  "kubernetes": { "managerFilePatterns": ["/\\.yaml$/"] },
  // Scoped: matching every *.yaml double-extracts image: lines and inflates minimumGroupSize counts
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml$/",
      "/(^|/)helm-release\\.ya?ml$/"
    ]
  },

  "packageRules": [
    {
      "groupName": "flux-operator",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/flux-operator/",
        "/flux-instance/",
        "/flux-operator-manifests/"
      ],
      "minimumGroupSize": 2
    }
  ]
}
